# Jarvis — local development environment template
#
# Copy to `.env` and fill in what you need. Every value here is optional:
# the bot degrades gracefully when a service is unconfigured. In production
# NONE of this file is used — secrets live only in Render's Environment tab
# (see render.yaml). Never commit a real `.env`.

# --- Core services (Milestone 1) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
DEEPGRAM_API_KEY=your-deepgram-key
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=your-voice-id
TELEGRAM_BOT_TOKEN=123456:your-bot-token
# 0 = lock onto the first human who messages
TELEGRAM_OWNER_CHAT_ID=0

# --- Models (defaults in app/config.py; override only when new ones ship) ---
# BRAIN_MODEL=claude-opus-5
# FAST_MODEL=claude-haiku-4-5
# DEEPGRAM_MODEL=nova-3
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Second brain (Milestone 2) ---
VOYAGE_API_KEY=your-voyage-key
# EMBED_MODEL=voyage-3.5-lite
# EMBED_DIM=1024
# MEMORY_ENABLED=true

# --- Storage ---
# Empty = local SQLite file (jarvis.db). On Render this is the Postgres URL.
DATABASE_URL=
# SQLITE_PATH=jarvis.db

# --- Web / webhook ---
# e.g. https://jarvis-xyz.onrender.com (unset for local polling via scripts/run_polling)
PUBLIC_URL=
# Random string; auto-derived from the bot token if empty
WEBHOOK_SECRET=

# --- Behaviour ---
# TIMEZONE_DEFAULT=Europe/London
# HISTORY_MESSAGES=40
# MAX_REPLY_VOICE_SECONDS=90

# --- Heartbeat (Milestone 4) ---
# HEARTBEAT_ENABLED=true
GMAIL_ADDRESS=you@example.com
GMAIL_APP_PASSWORD=your-gmail-app-password
KIEFER_EMAIL=kiefer@example.com
# One or more Google Calendar 'secret address in iCal format' URLs, comma-separated
CALENDAR_ICS_URL=

# --- Email inboxes (Phase 2) — one slot per account, Google app passwords ---
EMAIL1_ADDRESS=you@gmail.com
EMAIL1_APP_PASSWORD=sixteen-char-app-password
EMAIL2_ADDRESS=
EMAIL2_APP_PASSWORD=
EMAIL3_ADDRESS=
EMAIL3_APP_PASSWORD=

# --- Daily 12 / Trello (Milestone 3) ---
TRELLO_KEY=your-trello-key
TRELLO_TOKEN=your-trello-token
# Board scope: comma-separated board names, or "all" for every open board
# TRELLO_BOARDS=Master Board

# --- Phase 2 connectors (requested when needed) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Document library storage (Cloudflare R2, S3-compatible) ---
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Webhooks & private room (Milestone 6) ---
APPLE_HEALTH_WEBHOOK_SECRET=your-random-secret
# Encryption key for the sobriety room; generated once by Render in prod
PRIVATE_ROOM_KEY=

# --- Today's Focus sourcing (Master Update §2) ---
# TRELLO_TODAY_LIST=Paul Today
# TRELLO_PERSONAL_LIST=Paul Personal
# FOCUS_PER_COMPANY=3
# FOCUS_PERSONAL_MAX=3
